{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rankoff-git",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "RANKOFF_MODE": "production",
    "PAYMENTS_ENABLED": "true",
    "BOARD_SLUG": "global",
    "DEFAULT_CURRENCY": "USD",
    "DODO_ENVIRONMENT": "live_mode",
    "DODO_PRODUCT_ID": "pdt_0No559aj9N3tP44Zq26hj",
    "SOCIAL_PUBLISHING_ENABLED": "true",
    "SOCIAL_FACEBOOK_PAGE_ID": "1356018630922623",
    "SOCIAL_INSTAGRAM_USER_ID": "17841423594914143",
    "SOCIAL_START_AT": "2026-09-15T09:51:33.281Z"
  },
  "services": [{ "binding": "SOCIAL_RENDERER", "service": "rankoff-social-publisher" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rankoff-production",
      "database_id": "52a25d82-10ae-4c04-9781-55682c453ccd",
      "migrations_dir": "migrations"
    }
  ]
}
