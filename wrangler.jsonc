{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rankoff-git",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "RANKOFF_MODE": "production",
    "PAYMENTS_ENABLED": "true",
    "BOARD_SLUG": "global",
    "DEFAULT_CURRENCY": "MYR",
    "DODO_ENVIRONMENT": "live_mode",
    "DODO_PRODUCT_ID": "pdt_0NmSKNT2Fc2M9dSgRkEEZ",
    "SOCIAL_PUBLISHING_ENABLED": "false",
    "SOCIAL_FACEBOOK_PAGE_ID": "61594359445528",
    "SOCIAL_START_AT": "2026-09-14T00:00:00.000Z"
  },
  "services": [{ "binding": "SOCIAL_RENDERER", "service": "rankoff-social-publisher" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rankoff-production",
      "database_id": "52a25d82-10ae-4c04-9781-55682c453ccd",
      "migrations_dir": "migrations"
    }
  ]
}
